# Copy to .env for local use. On Vercel set the same names in Project Settings, Environment Variables.
# In GitHub Actions these come from repository secrets (see .github/workflows).

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only, never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Database (Prisma) ----------
# NOTE: URL-encode special characters in the password (@ becomes %40).
# Runtime: Supabase transaction pooler (port 6543). Add ?pgbouncer=true, and on Vercel also &connection_limit=1
# (each serverless function opens its own client).
DATABASE_URL=
# Migrations and CI: the SESSION pooler (port 5432). Not the db.<ref>.supabase.co host: it is
# IPv6-only and unreachable from GitHub runners.
DIRECT_URL=

# ---------- Cloudflare R2 (image store) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# public hostname the bucket is served from
NEXT_PUBLIC_IMG_CDN_HOST=

# ---------- Admin console ----------
# The console 404s unless you arrive through https://<site>/console?k=<ADMIN_ENTRY_TOKEN> once per session.
ADMIN_ENTRY_TOKEN=
# Signs the gate and pending-2FA cookies. REQUIRED in production: with no value the console stays closed.
ADMIN_GATE_SECRET=
# One-time: creates the FIRST admin on /console/setup. Delete it afterwards.
ADMIN_BOOTSTRAP_SECRET=

# ---------- Site ----------
# The real public address, e.g. https://example.com (no trailing slash). REQUIRED for SEO: canonical tags, sitemaps,
# structured data, share links and IndexNow all use it. Set it at BUILD time on Vercel, and as a GitHub secret.
NEXT_PUBLIC_SITE_URL=
# Search Console / Bing Webmaster ownership codes (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Shown on the DMCA / 2257 / privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------- Optional tuning ----------
# DB_RETRY_ATTEMPTS=12        retries for transient pooler errors in long jobs
# PAGE_CONCURRENCY=12         parallel page downloads (MangaDex)
# CHAPTER_CONCURRENCY=3       parallel chapters (MangaDex)
# HITOMI_PAGE_CONCURRENCY=8
# H2R_PAGE_CONCURRENCY=6
# IM_PAGE_CONCURRENCY=8       hentaifox / hentaiera / asmhentai / nhentai.xxx

# ---------- Analytics ----------
# The site measures itself (anonymous, no cookies, no IP stored); the numbers are in the console under Analytics.
# It only runs on the real production site (an https NEXT_PUBLIC_SITE_URL, not a preview deployment).
# ANALYTICS_SALT=             secret mixed into the anonymous visitor id. Defaults to ADMIN_GATE_SECRET. With neither set,
#                             production records NOTHING (an unsalted id could be reversed).
# ANALYTICS=off               kill switch: stops recording without a code change
# ANALYTICS_RETENTION_DAYS=120   raw rows older than this are deleted by the cleanup job (7 to 730)
# ANALYTICS_DEBUG=1           log to the server log why a request was skipped
# Optional Google Analytics 4 on top (leave empty for none). Needs a consent banner if you serve EU/UK visitors.
NEXT_PUBLIC_GA_ID=

# ---------- Ads ----------
# Where ads appear is fixed in code (src/lib/ads/registry.ts); which ads fill each place is managed in the console under Ads.
# Nothing is shown until an admin adds an ad. Ads are never shown to robots or signed-in admins, and are held back until the
# visitor has passed the 18+ gate.
# ADS=off                     kill switch for the whole deployment: no ad, no pop-under (also the "Show ads" switch in the console)
# ADS_CACHE_SECONDS=60        how long ad lists are cached (an admin's save drops the cache at once; tests use 1)
