{
  "name": "lustmanga",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:push": "prisma db push",
    "db:setup": "tsx --env-file=.env scripts/db-setup.mts",
    "ingest": "tsx --env-file=.env scripts/ingest.mts",
    "review": "tsx --env-file=.env scripts/review.mts",
    "verify": "tsx --env-file=.env scripts/verify.mts",
    "recompute": "tsx --env-file=.env scripts/recompute.mts",
    "health": "tsx --env-file=.env scripts/health.mts",
    "dedupe": "tsx --env-file=.env scripts/dedupe.mts",
    "rescan": "tsx --env-file=.env scripts/rescan.mts",
    "cleanup": "tsx --env-file=.env scripts/cleanup.mts",
    "qa": "tsx --env-file=.env e2e/qa.mts",
    "flows": "tsx --env-file=.env e2e/flows.mts",
    "backfill-thumbs": "tsx --env-file=.env scripts/backfill-thumbs.mts",
    "indexnow": "tsx --env-file=.env scripts/indexnow.mts",
    "seo": "tsx --env-file=.env e2e/seo.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
