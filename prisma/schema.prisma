generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum WorkKind {
  ONESHOT
  SERIES
}

enum WorkCategory {
  DOUJINSHI
  MANGA
  ARTIST_CG
  GAME_CG
  WESTERN
  IMAGE_SET
  OTHER
}

enum TagType {
  TAG
  ARTIST
  GROUP
  PARODY
  CHARACTER
  LANGUAGE
  CATEGORY
}

enum ChapterStatus {
  QUEUED
  FETCHING
  READY
  FAILED
}

enum SourceStatus {
  ACTIVE
  DEAD
  BLOCKED
}

/// Outcome of the ingest safety gate (src/lib/safety). Only REVIEW and CLEAN
/// ever reach the Work table; QUARANTINE is metadata-only (SuppressedSource).
enum SafetyVerdict {
  CLEAN
  REVIEW
}

model Work {
  id       String @id @default(cuid())
  /// numeric public id used in URLs: /g/{publicId}-{slug}
  publicId Int    @unique @default(autoincrement())
  /// random folder name for this work's images in R2 (not guessable from publicId)
  mediaId  String @unique @default(cuid())
  slug     String

  kind     WorkKind     @default(ONESHOT)
  category WorkCategory @default(MANGA)

  title         String
  titleOriginal String?
  altTitles     String[] @default([])
  description   String?
  /// ISO-ish language code: en, ja, zh, es, ...
  language      String   @default("en")
  /// all language variants of the same underlying work share this id
  translationGroupId String?
  /// normalised title (brackets stripped) used to recognise the same work from another source
  titleNorm String?

  pageCount Int     @default(0)
  coverKey  String?
  year      Int?

  publish PublishStatus @default(DRAFT)
  /// held for an admin to publish or reject (set by the safety gate)
  needsReview  Boolean  @default(false)
  safetyVerdict SafetyVerdict @default(CLEAN)
  /// why it was held, e.g. ["tag:school uniform"]
  safetyReasons String[] @default([])
  /// REVIEW works with explicit age markers: no images are downloaded until an admin approves
  deferFetch   Boolean  @default(false)
  /// APPROVED | REJECTED, set by the admin
  reviewDecision String?
  reviewedAt   DateTime?
  reviewedBy   String?
  autoPublishedAt DateTime?

  /// denormalised tag ids for fast AND / NOT filtering (GIN index, see db-setup)
  tagIds Int[] @default([])
  tags   Tag[] @relation("WorkTags")

  views          Int @default(0)
  favorites      Int @default(0)
  /// popularity imported from the source (follows etc.), seeds "Popular"
  seedPopularity Int @default(0)

  chapters Chapter[]
  sources  WorkSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([publish, createdAt])
  @@index([publish, language, createdAt])
  @@index([publish, seedPopularity])
  @@index([needsReview, publish])
  @@index([translationGroupId])
  @@index([language, titleNorm])
  @@index([slug])
}

model Tag {
  id    Int     @id @default(autoincrement())
  type  TagType
  name  String
  slug  String
  /// number of PUBLISHED works carrying this tag (maintained by recompute)
  count Int     @default(0)
  /// admin controls: hidden tags are not shown on public pages; featured ones are promoted
  hidden   Boolean @default(false)
  featured Boolean @default(false)
  description String?
  works Work[]  @relation("WorkTags")
  aliases TagAlias[]

  @@unique([type, slug])
  @@index([type, count])
}

model Chapter {
  id      String @id @default(cuid())
  /// failed fetch attempts; chapters stop being retried after 6
  attempts Int @default(0)
  workId  String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// chapter number; one-shots use 1
  number  Float
  volume  String?
  title   String?
  pageCount Int @default(0)
  /// compact per-page data: [[width, height, bytes, ext?], ...] in reading order. Keys are derived
  /// (w/{mediaId}/{chapterId}/{n}.{ext}) so a page costs bytes, not a database row.
  pageData Json?
  /// total stored bytes for this chapter
  bytes Int @default(0)
  /// perceptual hash of the first page (cross-source dedupe)
  phash String?
  status  ChapterStatus @default(QUEUED)
  error   String?
  /// upstream chapter id on the source site
  sourceChapterId String?
  publishedAt DateTime?


  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([workId, number])
  @@index([workId, status])
  @@index([status])
}


/// A link from our Work to the upstream gallery / series it came from.
model WorkSource {
  id         String       @id @default(cuid())
  workId     String
  work       Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  site       String
  externalId String
  url        String
  status     SourceStatus @default(ACTIVE)
  lastFetchedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([site, externalId])
  @@index([workId])
}

/// Works the safety gate quarantined. Metadata only — no images are ever
/// downloaded or stored for these, and the id is kept so discovery never
/// re-fetches them. There is deliberately no publish path for this table.
model SuppressedSource {
  id         String   @id @default(cuid())
  site       String
  externalId String
  title      String
  reasons    String[]
  /// admin has looked at it and confirmed the suppression
  confirmedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([site, externalId])
}

model IngestRun {
  id         String    @id @default(cuid())
  site       String
  mode       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  worksSeen        Int @default(0)
  worksCreated     Int @default(0)
  worksHeld        Int @default(0)
  worksSuppressed  Int @default(0)
  duplicates       Int @default(0)
  chaptersFetched  Int @default(0)
  pagesStored      Int @default(0)
  errors     String[]  @default([])

  @@index([site, startedAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

/// A source tag name that resolves to one of our canonical tags (created by merging).
model TagAlias {
  id          String  @id @default(cuid())
  type        TagType
  slug        String
  name        String
  targetTagId Int
  target      Tag     @relation(fields: [targetTagId], references: [id], onDelete: Cascade)

  @@unique([type, slug])
  @@index([targetTagId])
}

enum SafetyTier {
  /// source-tagged child sexualisation: metadata only, never downloaded or published
  QUARANTINE
  /// explicit age markers: held for an admin, NOT downloaded until approved
  DEFER
  /// ambiguous markers: held for an admin, downloaded so they can inspect
  REVIEW
  /// normal adult phrases that contain a flagged word (suppresses a match)
  ALLOWED
}

/// Admin-editable term lists for the ingest safety gate. The core QUARANTINE terms
/// (src/lib/safety/core.ts) are enforced from code and cannot be removed here.
model SafetyTerm {
  id        String     @id @default(cuid())
  term      String
  tier      SafetyTier
  /// core terms: seeded from code, protected from edit/delete
  locked    Boolean    @default(false)
  createdBy String?
  createdAt DateTime   @default(now())

  @@unique([term, tier])
  @@index([tier])
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("OWNER") // OWNER | ADMIN | MOD
  displayName   String?
  totpSecret    String?
  totpEnabledAt DateTime?
  backupCodes   String[]  @default([])
  active        Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Two Works that may be the same release from different sources. Confident matches are merged
/// automatically; the rest wait here for an admin (Console, Duplicates).
model DuplicateCandidate {
  id        String   @id @default(cuid())
  /// the newer work
  workId    String
  /// the existing work it may duplicate
  otherId   String
  score     Float
  reasons   String[] @default([])
  /// OPEN | MERGED | DISMISSED
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@unique([workId, otherId])
  @@index([status, createdAt])
}
