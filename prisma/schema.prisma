generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

enum WorkKind {
  ONESHOT
  SERIES
}

enum WorkCategory {
  DOUJINSHI
  MANGA
  ARTIST_CG
  GAME_CG
  WESTERN
  IMAGE_SET
  OTHER
}

enum TagType {
  TAG
  ARTIST
  GROUP
  PARODY
  CHARACTER
  LANGUAGE
  CATEGORY
}

enum ChapterStatus {
  QUEUED
  FETCHING
  READY
  FAILED
}

enum SourceStatus {
  ACTIVE
  DEAD
  BLOCKED
}

/// Outcome of the ingest safety gate (src/lib/safety). Only REVIEW and CLEAN
/// ever reach the Work table; QUARANTINE is metadata-only (SuppressedSource).
enum SafetyVerdict {
  CLEAN
  REVIEW
}

model Work {
  id       String @id @default(cuid())
  /// numeric public id used in URLs: /g/{publicId}-{slug}
  publicId Int    @unique @default(autoincrement())
  /// random folder name for this work's images in R2 (not guessable from publicId)
  mediaId  String @unique @default(cuid())
  slug     String

  kind     WorkKind     @default(ONESHOT)
  category WorkCategory @default(MANGA)

  title         String
  titleOriginal String?
  altTitles     String[] @default([])
  description   String?
  /// ISO-ish language code: en, ja, zh, es, ...
  language      String   @default("en")
  /// all language variants of the same underlying work share this id
  translationGroupId String?
  /// normalised title (brackets stripped) used to recognise the same work from another source
  titleNorm String?

  pageCount Int     @default(0)
  coverKey  String?
  year      Int?

  publish PublishStatus @default(DRAFT)
  /// held for an admin to publish or reject (set by the safety gate)
  needsReview  Boolean  @default(false)
  safetyVerdict SafetyVerdict @default(CLEAN)
  /// why it was held, e.g. ["tag:school uniform"]
  safetyReasons String[] @default([])
  /// REVIEW works with pre-download flags: no images are downloaded until an admin approves
  deferFetch   Boolean  @default(false)
  /// APPROVED | REJECTED, set by the admin
  reviewDecision String?
  reviewedAt   DateTime?
  reviewedBy   String?
  autoPublishedAt DateTime?

  /// denormalised tag ids for fast AND / NOT filtering (GIN index, see db-setup)
  tagIds Int[] @default([])
  tags   Tag[] @relation("WorkTags")

  views          Int @default(0)
  favorites      Int @default(0)
  /// popularity imported from the source (follows etc.), seeds "Popular"
  seedPopularity Int @default(0)

  /// What the SOURCE sites say about the work, refreshed by `npm run signals`. These (not our own traffic) drive
  /// Popular, Trending and Top rated, so a brand-new site with no readers still ranks sensibly.
  /// followers / favourites on the source
  srcFavorites Int      @default(0)
  /// views on the source
  srcViews     Int      @default(0)
  /// average rating on the source, 0-10 (null = the source has no ratings)
  srcRating    Float?
  /// how many votes that rating rests on
  srcVotes     Int      @default(0)
  /// momentum scores, 0-50000: rank in the source's own "popular today / this week / this month" list, or growth in
  /// followers or views since the last snapshot. 0 = not in any such list
  trendDay     Int      @default(0)
  trendWeek    Int      @default(0)
  trendMonth   Int      @default(0)
  signalsAt    DateTime?
  /// when the source says it published the work (nhentai.xxx and HentaiFox show it on the page); lets a new, fast-rising work count as trending
  sourceAt     DateTime?
  /// last time this work's own source page was read for its counters (the stalest are refreshed first)
  statsAt      DateTime?

  chapters Chapter[]
  sources  WorkSource[]
  viewDays WorkViewDay[]
  snapshots SignalSnapshot[]

  /// What readers of THIS site think: the sum and count of their 1-5 star ratings (kept here so a page shows the average without a query)
  ratingSum   Int @default(0)
  ratingCount Int @default(0)
  ratings     WorkRating[]
  comments    Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([publish, createdAt])
  @@index([publish, language, createdAt])
  @@index([publish, seedPopularity])
  @@index([needsReview, publish])
  @@index([translationGroupId])
  @@index([language, titleNorm])
  @@index([slug])
}

model Tag {
  id    Int     @id @default(autoincrement())
  type  TagType
  name  String
  slug  String
  /// number of PUBLISHED works carrying this tag (maintained by recompute)
  count Int     @default(0)
  /// admin controls: hidden tags are not shown on public pages; featured ones are promoted
  hidden   Boolean @default(false)
  featured Boolean @default(false)
  description String?
  works Work[]  @relation("WorkTags")
  aliases TagAlias[]

  @@unique([type, slug])
  @@index([type, count])
}

model Chapter {
  id      String @id @default(cuid())
  /// failed fetch attempts; chapters stop being retried after 6
  attempts Int @default(0)
  workId  String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// chapter number; one-shots use 1
  number  Float
  volume  String?
  title   String?
  pageCount Int @default(0)
  /// compact per-page data: [[width, height, bytes, ext?], ...] in reading order. Keys are derived
  /// (w/{mediaId}/{chapterId}/{n}.{ext}) so a page costs bytes, not a database row.
  pageData Json?
  /// total stored bytes for this chapter
  bytes Int @default(0)
  /// perceptual hash of the first page (cross-source dedupe)
  phash String?
  status  ChapterStatus @default(QUEUED)
  error   String?
  /// upstream chapter id on the source site
  sourceChapterId String?
  publishedAt DateTime?


  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([workId, number])
  @@index([workId, status])
  @@index([status])
}


/// A link from our Work to the upstream gallery / series it came from.
model WorkSource {
  id         String       @id @default(cuid())
  workId     String
  work       Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  site       String
  externalId String
  url        String
  status     SourceStatus @default(ACTIVE)
  lastFetchedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([site, externalId])
  @@index([workId])
}

/// Works the safety gate quarantined. Metadata only — no images are ever
/// downloaded or stored for these, and the id is kept so discovery never
/// re-fetches them. There is deliberately no publish path for this table.
model SuppressedSource {
  id         String   @id @default(cuid())
  site       String
  externalId String
  title      String
  reasons    String[]
  /// admin has looked at it and confirmed the suppression
  confirmedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([site, externalId])
}

model IngestRun {
  id         String    @id @default(cuid())
  site       String
  mode       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  worksSeen        Int @default(0)
  worksCreated     Int @default(0)
  worksHeld        Int @default(0)
  worksSuppressed  Int @default(0)
  duplicates       Int @default(0)
  chaptersFetched  Int @default(0)
  pagesStored      Int @default(0)
  errors     String[]  @default([])

  @@index([site, startedAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

/// A source tag name that resolves to one of our canonical tags (created by merging).
model TagAlias {
  id          String  @id @default(cuid())
  type        TagType
  slug        String
  name        String
  targetTagId Int
  target      Tag     @relation(fields: [targetTagId], references: [id], onDelete: Cascade)

  @@unique([type, slug])
  @@index([targetTagId])
}

enum SafetyTier {
  /// source-tagged child sexualisation: metadata only, never downloaded or published
  QUARANTINE
  /// pre-download flags: held for an admin, NOT downloaded until approved
  DEFER
  /// ambiguous markers: held for an admin, downloaded so they can inspect
  REVIEW
  /// normal adult phrases that contain a flagged word (suppresses a match)
  ALLOWED
}

/// Admin-editable term lists for the ingest safety gate.
model SafetyTerm {
  id        String     @id @default(cuid())
  term      String
  tier      SafetyTier
  /// core terms: seeded from code, protected from edit/delete
  locked    Boolean    @default(false)
  createdBy String?
  createdAt DateTime   @default(now())

  @@unique([term, tier])
  @@index([tier])
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("OWNER") // OWNER | ADMIN | MOD
  displayName   String?
  totpSecret    String?
  totpEnabledAt DateTime?
  backupCodes   String[]  @default([])
  active        Boolean   @default(true)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  @@index([adminId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  ok        Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String
  targetId   String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Two Works that may be the same release from different sources. Confident matches are merged
/// automatically; the rest wait here for an admin (Console, Duplicates).
model DuplicateCandidate {
  id        String   @id @default(cuid())
  /// the newer work
  workId    String
  /// the existing work it may duplicate
  otherId   String
  score     Float
  reasons   String[] @default([])
  /// OPEN | MERGED | DISMISSED
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@unique([workId, otherId])
  @@index([status, createdAt])
}

/// Visitor reports: takedown requests, broken galleries, anything else. Reviewed in the console.
model Report {
  id        String   @id @default(cuid())
  /// public id of the work being reported, if any
  workId    Int?
  kind      String   @default("OTHER") // DMCA | BROKEN | OTHER
  details   String
  contact   String?
  /// one-way hash of the reporter's IP, only used to rate-limit
  ipHash    String?
  status    String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

/// Permanent redirects for URLs that used to exist: a work merged into another during dedupe keeps
/// sending visitors (and search engines) to the surviving page instead of a 404.
model RedirectMap {
  fromPath  String   @id
  toPath    String
  createdAt DateTime @default(now())
}

/// Views per work per day: the "Trending / This week / This month" sorts add up the last few days. Old rows are
/// deleted by the cleanup job, so this stays small however many views there are.
model WorkViewDay {
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  views  Int    @default(0)

  @@id([workId, day])
  @@index([day])
}

/// A daily photograph of a work's source numbers. Growth between two photographs is what "trending" means for sources
/// that only publish totals. Rows older than about six weeks are deleted by the cleanup job.
model SignalSnapshot {
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  favorites Int      @default(0)
  views     Int      @default(0)
  /// the work's popularity score (0-50000) from a source's ranked list, for sources that publish ranks instead of counts
  score     Int      @default(0)

  @@id([workId, day])
  @@index([day])
}

// ───────────────────────────── analytics ─────────────────────────────
// First-party, cookieless and anonymous. There is no IP address and no cookie here: `visitor` is a one-way hash of
// (ip, user agent) salted with a secret AND the UTC date, so it can tell two page views of one browser apart from two
// browsers within a single day, but it cannot follow anyone from one day to the next (see src/lib/analytics/visitor.ts).
// The cleanup job deletes everything older than ANALYTICS_RETENTION_DAYS.

/// One page view. `id` is made by the browser so the later "leave" report can find the row without a round trip.
model PageView {
  id       String   @id
  at       DateTime @default(now())
  visitor  String
  /// normalised: no query string, no slug (/g/123, /read/123, /tag/big-breasts)
  path     String
  /// home | browse | work | read | tag | search | list | static | other
  kind     String
  /// the work's public id for work and reader pages
  workId   Int?
  /// host of the page the visitor came from, only on the first view after arriving (null = direct or internal)
  referrer String?
  /// direct | search | social | referral
  refKind  String   @default("direct")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// ISO 3166 alpha-2, from the CDN's country header
  country  String?
  /// mobile | tablet | desktop
  device   String
  browser  String?
  os       String?
  /// primary language of the browser, e.g. "en"
  lang     String?
  /// true when the age gate was still showing
  gated    Boolean  @default(false)
  /// seconds the page was visible and in use, reported when the visitor leaves; null if that report never arrived
  seconds  Int?

  @@index([at])
  @@index([kind, at])
  @@index([workId, at])
  @@index([visitor, at])
}

/// Something a visitor did: searched, started or finished reading, saved a work, downloaded, passed the age gate, hit a 404.
model AnalyticsEvent {
  id      String   @id
  at      DateTime @default(now())
  visitor String
  /// search | read_start | read_end | favorite | follow | download | share | age_gate | not_found
  name    String
  path    String?
  workId  Int?
  /// the search words, the tag followed, "add" / "remove", the 404 path...
  label   String?
  /// result count, last page reached...
  value   Int?
  /// pages in the chapter, for read_end
  total   Int?

  @@index([name, at])
  @@index([workId, at])
  @@index([at])
}

/// Real-user Core Web Vitals, one row per metric per page load, so the console can show what visitors actually experience.
model WebVital {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  /// LCP | INP | CLS | FCP | TTFB
  metric String
  /// milliseconds; CLS is multiplied by 1000
  value  Int
  /// good | needs-improvement | poor
  rating String
  kind   String
  device String

  @@index([at])
  @@index([metric, at])
}

// ───────────────────────────── advertising ─────────────────────────────
// Where ads may appear is fixed in code (src/lib/ads/registry.ts); WHICH ads appear is managed in the console. Nothing is
// shown until an admin adds an ad to a slot.

/// One creative bound to a named slot. A slot can hold several; the server picks among those that match the visitor's
/// device and the schedule: the highest `priority` wins, and ads of equal priority share the slot by `weight`.
model Ad {
  id        String    @id @default(cuid())
  /// a key of the slot registry
  slot      String
  name      String
  /// code (an ad network's embed code) | banner (an image that links out)
  type      String    @default("code")
  /// all | desktop | mobile. An ad for the visitor's own device beats an "all" ad.
  device    String    @default("all")
  code      String?
  imageUrl  String?
  linkUrl   String?
  alt       String?
  width     Int?
  height    Int?
  /// code ads only: inline (runs in the page, as most networks expect) | frame (a sandboxed frame; nothing it runs can touch the site)
  isolation String    @default("inline")
  priority  Int       @default(0)
  weight    Int       @default(1)
  startsAt  DateTime?
  endsAt    DateTime?
  active    Boolean   @default(true)
  note      String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  stats     AdStat[]

  @@index([slot, active])
}

/// Ad boxes shown and banner clicks, per ad per UTC day. Impressions are counted when the box has been at least half in view
/// for a second (never before the age gate is passed); clicks only exist for banners, which go through /go/ad/<id>. An ad
/// network reports its own clicks and billed impressions.
model AdStat {
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@id([adId, day])
  @@index([day])
}

/* ───────────────────────────── members: accounts, ratings, comments ───────────────────────────── */

/// A reader with an account. Reading never needs one; an account is for rating and commenting. The sign-in name is the
/// handle (lower case); no email is needed, so there is no mail to verify: a lost password is recovered with one of the
/// recovery codes shown once at sign-up. An email, when given, is kept for the owner of the account only and is not used yet.
model Member {
  id             String    @id @default(cuid())
  /// the sign-in name and profile address, lower case: 3-20 letters, digits and underscores
  handle         String    @unique
  /// the same name as the member typed it (capitals kept)
  displayName    String
  /// kept private, not verified and not used yet; not unique, so nobody can block or probe for an address
  email          String?
  passwordHash   String
  bio            String?
  /// bcrypt hashes of the recovery codes not used yet
  recoveryHashes String[]  @default([])
  /// whether the ratings of this member are listed on their public profile (comments are public by nature)
  showRatings    Boolean   @default(false)
  banned         Boolean   @default(false)
  bannedReason   String?
  bannedAt       DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  sessions MemberSession[]
  ratings  WorkRating[]
  comments Comment[]
  votes    CommentVote[]
  reports  CommentReport[]

  @@index([email])
}

/// A signed-in browser. Only the sha256 of the cookie token is stored.
model MemberSession {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([memberId])
  @@index([expiresAt])
}

/// Sign-in, sign-up and reset attempts, so repeated failures can be slowed down. The key is a handle or a one-way hash of an
/// address; rows older than a month are deleted by the nightly cleanup.
model MemberAttempt {
  id        String   @id @default(cuid())
  kind      String // login | signup | reset | comment | report
  key       String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

/// One member rating of one work, 1 to 5 stars.
model WorkRating {
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@id([memberId, workId])
  @@index([workId])
}

enum CommentStatus {
  VISIBLE
  /// held back by reports or a moderator; the author still sees it marked as hidden
  HIDDEN
  /// taken down for good (kept as a row so replies keep their place)
  REMOVED
}

model Comment {
  id        String        @id @default(cuid())
  workId    String
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// null once the author deleted their account
  memberId  String?
  member    Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// replies are one level deep: the parent of a reply is always a top-level comment
  parentId  String?
  parent    Comment?      @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentTree")
  body      String
  status    CommentStatus @default(VISIBLE)
  /// up votes minus down votes
  score     Int           @default(0)
  edited    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  votes   CommentVote[]
  reports CommentReport[]

  @@index([workId, status, createdAt])
  @@index([parentId])
  @@index([memberId, createdAt])
  @@index([status, updatedAt])
}

model CommentVote {
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// 1 or -1
  value     Int
  createdAt DateTime @default(now())

  @@id([commentId, memberId])
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reason    String // SPAM | ABUSE | MINORS | PRIVATE | OTHER
  details   String?
  status    String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt DateTime @default(now())

  @@unique([commentId, memberId])
  @@index([status, createdAt])
}
